# Copy to `.env.local` for local `npm run dev`. Never commit real secrets.
# Docker Compose: use `.env.docker.example` / `.env.production.example` instead.

# --- PostgreSQL (Drizzle) — recommended ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Runtime provider for the SAQ repository facade.
# Recommended: postgres. If unset, the selector defaults to supabase (legacy).
SAQ_DATABASE_PROVIDER=postgres

# --- Auth.js / NextAuth ---
NEXTAUTH_SECRET=generate_a_long_random_string
# AUTH_SECRET is accepted as an alias of NEXTAUTH_SECRET
# AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional URL prefix at build time (empty = site root). See next.config.js / docs/DOCKER.md
# NEXT_PUBLIC_BASE_PATH=

# --- Legacy Supabase (only when SAQ_DATABASE_PROVIDER=supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SITE_URL=https://your-public-origin.example
