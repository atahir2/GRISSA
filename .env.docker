# Copy to `.env.docker` and adjust secrets. Never commit `.env.docker`.
# Compose: docker compose --env-file .env.docker up --build

# --- PostgreSQL (must match postgres service credentials) ---
POSTGRES_DB=grisc_sa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123

# URL seen from OTHER containers on the Compose network — host name `postgres`:
DATABASE_URL=postgresql://postgres:admin123@postgres:5432/grisc_sa

# Optional host port mapping (postgres service → your machine). Default 5432.
# POSTGRES_HOST_PORT=5432

# --- App ---
SAQ_DATABASE_PROVIDER=postgres

# NextAuth — set a long random string in production (same value can be echoed as AUTH_SECRET)
NEXTAUTH_SECRET=RYv1JI5vDw5U5dSKwx+cYDY87HBh9q7JJ53MpjBYHT+q8bSAblQZ3I/qv6gWs2EG
AUTH_SECRET=RYv1JI5vDw5U5dSKwx+cYDY87HBh9q7JJ53MpjBYHT+q8bSAblQZ3I/qv6gWs2EG

# URLs users use in the browser to reach the app (OAuth callbacks / session cookies)
NEXTAUTH_URL=http://localhost:3000

# Served at site root inside Docker (--build-arg NEXT_PUBLIC_BASE_PATH defaults to empty)
NEXT_PUBLIC_BASE_PATH=

# APP_HOST_PORT=3000
# ADMINER_HOST_PORT=8080

# Real confirmation email and password reset. Leave these unset until you have a mailbox.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=a Google App Password (not your normal Gmail password),
# EMAIL_FROM=GRISSA <your@gmail.com>
# After saving, recreate the app container: npm run docker:up
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# The button is on the login page. Sign-in starts after both values are set and the app container is recreated.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ORCID sign-in. Register a client at https://orcid.org/developer-tools
# Authorized redirect URI: http://localhost:3000/api/auth/callback/orcid
# ORCID_CLIENT_ID=
# ORCID_CLIENT_SECRET=
ORCID_ISSUER=https://orcid.org
ORCID_SCOPES=openid

# Evidence uploads. Compose mounts a volume here. Files stay outside public/.
SAQ_EVIDENCE_DIR=/app/data/evidence
